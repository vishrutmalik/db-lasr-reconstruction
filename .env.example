# Environment variable NAMES used by the LASR data layer (G018).
# Never commit values. Credentials/paths are read only by `config`
# (system_design.md §4 rule table); providers receive them as constructor
# arguments and never touch the environment (provider_contract.md §0,
# MP §16: no committed credentials, values never logged).

# ── local-file (AlphaSense-template) provider ────────────────────────────────
# Root directory of workbook template extracts
# (inputs/data_templates/ drops converted to the CSV extract layout —
# see src/lasr/data/providers/local_file.py module docstring).
LASR_LOCAL_TEMPLATE_ROOT=

# ── future real-API providers (G039 integration guide) ──────────────────────
# Names reserved now so the auth surface is pinned without inventing
# endpoints (provider_contract.md §4.3). All unset until a real adapter
# lands.
LASR_API_BASE_URL=
LASR_API_KEY=
LASR_API_SECRET=
